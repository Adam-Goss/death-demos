<?xml version="1.0"?>
<opnsense>
  <theme>opnsense</theme>
  <OPNsense>
    <Gateways>
      <gateway_item>
        <name>WAN_GW</name>
        <interface>wan</interface>
        <gateway>192.168.0.1</gateway>
        <defaultgw>1</defaultgw>
        <ipprotocol>inet</ipprotocol>
      </gateway_item>
    </Gateways>
    <unboundplus>
      <general>
        <enabled>1</enabled>
        <active_interface>lan,opt1,opt2,opt3</active_interface>
      </general>
    </unboundplus>
    <Interfaces>
      <settings>
        <disablechecksumoffloading>1</disablechecksumoffloading>
        <disablesegmentationoffloading>1</disablesegmentationoffloading>
        <disablelargereceiveoffloading>1</disablelargereceiveoffloading>
        <disableipv6>1</disableipv6>
      </settings>
    </Interfaces>
    <wireguard>
      <general>
        <enabled>1</enabled>
      </general>
      <server>
        <servers>
          <server uuid="1906e02c-a244-5045-abcb-53e8daba5394">
            <enabled>1</enabled>
            <name>lab</name>
            <instance>0</instance>
            <pubkey>@@WG_PUBLIC_KEY@@</pubkey>
            <privkey>@@WG_PRIVATE_KEY@@</privkey>
            <port>51820</port>
            <tunneladdress>10.77.9.1/24</tunneladdress>
            <peers>cbeed826-06c0-57fb-bf16-dffcc8cbc83f</peers>
          </server>
        </servers>
      </server>
      <client>
        <clients>
          <client uuid="cbeed826-06c0-57fb-bf16-dffcc8cbc83f">
            <enabled>1</enabled>
            <name>workstation</name>
            <pubkey>@@WG_PEER_PUBLIC_KEY@@</pubkey>
            <tunneladdress>10.77.9.2/32</tunneladdress>
          </client>
        </clients>
      </client>
    </wireguard>
    <Firewall>
      <Filter>
        <rules>
          <rule uuid="e95325f8-69e1-58a9-80ac-c1622a321da6">
            <enabled>1</enabled>
            <action>block</action>
            <quick>1</quick>
            <interface>wan</interface>
            <direction>in</direction>
            <ipprotocol>inet6</ipprotocol>
            <protocol>any</protocol>
            <source_net>any</source_net>
            <destination_net>any</destination_net>
            <destination_port />
            <log>1</log>
            <sequence>1</sequence>
            <description>opaleye:v6-block@wan</description>
          </rule>
          <rule uuid="ae588abd-4894-560f-a9a3-3eba02b29a80">
            <enabled>1</enabled>
            <action>pass</action>
            <quick>1</quick>
            <interface>wan</interface>
            <direction>in</direction>
            <ipprotocol>inet</ipprotocol>
            <protocol>UDP</protocol>
            <source_net>192.168.0.223/32</source_net>
            <destination_net>(self)</destination_net>
            <destination_port>51820</destination_port>
            <log>0</log>
            <sequence>2</sequence>
            <description>opaleye:vpn-handshake@wan@workstation:51820</description>
          </rule>
          <rule uuid="fbcb20c8-e175-53e7-addb-3be862c96416">
            <enabled>1</enabled>
            <action>block</action>
            <quick>1</quick>
            <interface>wan</interface>
            <direction>in</direction>
            <ipprotocol>inet</ipprotocol>
            <protocol>any</protocol>
            <source_net>any</source_net>
            <destination_net>any</destination_net>
            <destination_port />
            <log>1</log>
            <sequence>3</sequence>
            <description>opaleye:deny-all@wan</description>
          </rule>
          <rule uuid="4ec47248-bf7d-5817-a211-96c0ccbe77c9">
            <enabled>1</enabled>
            <action>block</action>
            <quick>1</quick>
            <interface>opt4</interface>
            <direction>in</direction>
            <ipprotocol>inet6</ipprotocol>
            <protocol>any</protocol>
            <source_net>any</source_net>
            <destination_net>any</destination_net>
            <destination_port />
            <log>1</log>
            <sequence>4</sequence>
            <description>opaleye:v6-block@opt4</description>
          </rule>
          <rule uuid="65dbea96-f206-58a4-99c8-fbfa169adc6e">
            <enabled>1</enabled>
            <action>pass</action>
            <quick>1</quick>
            <interface>opt4</interface>
            <direction>in</direction>
            <ipprotocol>inet</ipprotocol>
            <protocol>TCP</protocol>
            <source_net>10.77.9.0/24</source_net>
            <destination_net>(self)</destination_net>
            <destination_port>443</destination_port>
            <log>0</log>
            <sequence>5</sequence>
            <description>opaleye:op-fw-admin@opt4@vpn:443</description>
          </rule>
          <rule uuid="31f882b7-e60f-50d6-a978-e4e07df02826">
            <enabled>1</enabled>
            <action>block</action>
            <quick>1</quick>
            <interface>opt4</interface>
            <direction>in</direction>
            <ipprotocol>inet</ipprotocol>
            <protocol>any</protocol>
            <source_net>any</source_net>
            <destination_net>any</destination_net>
            <destination_port />
            <log>1</log>
            <sequence>11</sequence>
            <description>opaleye:deny-all@opt4</description>
          </rule>
        </rules>
      </Filter>
    </Firewall>
  </OPNsense>
  <system>
    <hostname>opaleye-firewall</hostname>
    <domain>lab.internal</domain>
    <timezone>Etc/UTC</timezone>
    <dnsserver>192.168.0.1</dnsserver>
    <webgui>
      <protocol>https</protocol>
      <noantilockout>1</noantilockout>
    </webgui>
    <user>
      <name>root</name>
      <scope>system</scope>
      <uid>0</uid>
      <groupname>admins</groupname>
      <password>@@ROOT_PASSWORD@@</password>
    </user>
    <user>
      <name>opaleye-api</name>
      <scope>user</scope>
      <uid>2000</uid>
      <descr>Opaleye labmode API user (rules, aliases, firewall log only)</descr>
      <password>*</password>
      <priv>page-diagnostics-logs-firewall-dynamic</priv>
      <priv>page-diagnostics-logs-firewall-plain</priv>
      <priv>page-diagnostics-logs-firewall-summary</priv>
      <priv>page-firewall-alias-edit</priv>
      <priv>page-firewall-aliases</priv>
      <priv>page-filter-api</priv>
      <priv>page-firewall-rules-edit</priv>
      <priv>page-wireguard-diagnostics</priv>
      <apikeys>@@API_KEY@@|@@API_SECRET@@</apikeys>
    </user>
  </system>
  <interfaces>
    <wan>
      <if>vtnet0</if>
      <descr>home</descr>
      <enable>1</enable>
      <ipaddr>192.168.0.82</ipaddr>
      <subnet>24</subnet>
      <gateway>WAN_GW</gateway>
    </wan>
    <lan>
      <if>vtnet1</if>
      <descr>attacker</descr>
      <enable>1</enable>
      <ipaddr>10.77.1.1</ipaddr>
      <subnet>24</subnet>
    </lan>
    <opt1>
      <if>vtnet2</if>
      <descr>elastic</descr>
      <enable>1</enable>
      <ipaddr>10.77.3.1</ipaddr>
      <subnet>24</subnet>
    </opt1>
    <opt2>
      <if>vtnet3</if>
      <descr>t1</descr>
      <enable>1</enable>
      <ipaddr>10.77.11.1</ipaddr>
      <subnet>24</subnet>
    </opt2>
    <opt3>
      <if>vtnet4</if>
      <descr>t2</descr>
      <enable>1</enable>
      <ipaddr>10.77.12.1</ipaddr>
      <subnet>24</subnet>
    </opt3>
    <opt4>
      <if>wg0</if>
      <descr>vpn</descr>
      <enable>1</enable>
    </opt4>
  </interfaces>
  <ntpd>
    <interface>lan,opt1,opt2,opt3</interface>
  </ntpd>
</opnsense>
