    <domain>lab.internal</domain>
    <timezone>Etc/UTC</timezone>
    <timeservers>0.opnsense.pool.ntp.org 1.opnsense.pool.ntp.org 2.opnsense.pool.ntp.org 3.opnsense.pool.ntp.org</timeservers>
    <dnsserver>127.0.0.1</dnsserver>
    <dnsallowoverride>0</dnsallowoverride>
    <webgui>
      <protocol>https</protocol>
      <noantilockout>1</noantilockout>
    </webgui>
    <group>
      <gid>1999</gid>
      <name>admins</name>
      <scope>system</scope>
      <description>System Administrators</description>
      <priv>page-all</priv>
      <member>0</member>
    </group>
    <user>
      <name>root</name>
      <scope>system</scope>
      <uid>0</uid>
      <descr>System Administrator</descr>
      <password>@@ROOT_PASSWORD@@</password>
    </user>
    <user>
      <name>opaleye-api</name>
      <scope>user</scope>
      <uid>2000</uid>
      <descr>Opaleye labmode API user (rules, aliases, firewall log only)</descr>
      <password>*</password>
      <priv>page-diagnostics-logs-firewall-dynamic</priv>
      <priv>page-diagnostics-logs-firewall-plain</priv>
      <priv>page-diagnostics-logs-firewall-summary</priv>
      <priv>page-firewall-alias-edit</priv>
      <priv>page-firewall-aliases</priv>
      <priv>page-filter-api</priv>
      <priv>page-firewall-rules-edit</priv>
      <priv>page-wireguard-diagnostics</priv>
      <apikeys>@@API_KEY@@|@@API_SECRET@@</apikeys>
    </user>
  </system>
